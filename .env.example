# Copy settings into .dev.vars for Wrangler; never commit real secrets.
ENVIRONMENT=development
APP_URL=http://127.0.0.1:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# HTTPS MapLibre style URL from a provider licensed for an ad-supported site.
MAP_STYLE_URL=
