{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "coeliac-malta",
	"main": "src/server/index.tsx",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "coeliac-malta",
			"database_id": "f107da83-4d9e-4749-bef9-c1b398251d84",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "coeliac-malta-photos"
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"APP_URL": "https://glutenfree.mt",
		"MAP_STYLE_URL": ""
	},
	"triggers": {
		"crons": [
			"0 3 * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}
